{
  "manifest_version": 3,
  "name": "AI Form Fill Lokal",
  "version": "0.1.0",
  "description": "Isi formulir web otomatis dengan data uji realistis dari model AI lokal (Ollama, LM Studio, dll). Data tidak keluar dari komputer.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "AI Form Fill", "default_popup": "popup/popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "declarativeNetRequest"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "commands": {
    "fill-page": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Isi form di halaman ini dengan AI" },
    "undo-fill": { "suggested_key": { "default": "Alt+Shift+Z" }, "description": "Urungkan isian terakhir" }
  }
}
